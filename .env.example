# Application credentials: configured once by the MailFlow team on the server.
# Users of the hosted app only click "Log in with Google"; they need no .env file.
# For local development, copy this file to frontend/.env.local and fill it in.
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
# In production, register and use https://your-domain.com/api/google/callback.

# Managed PostgreSQL connection string. Keep SSL requirements in the URL,
# for example: postgresql://user:password@host/database?sslmode=verify-full
DATABASE_URL="postgresql://user:password@host/database?sslmode=verify-full"

# Generate a long random value and keep it server-side. Changing it invalidates
# stored OAuth sessions because Google tokens are encrypted with this secret.
SESSION_SECRET="replace-with-at-least-32-random-bytes"

# Key for encrypting user content before it is stored (drafts, AI summaries,
# About-you answers, task text). Generate a long random value, set it ONLY in the
# production host's environment, and never share it or put it in a file that is
# passed around: anyone with this key and database access can read users' data.
# If unset, a key derived from SESSION_SECRET is used. Changing it makes
# previously stored content unreadable.
DATA_ENCRYPTION_KEY="another-long-random-value"

# Optional per-instance connection-pool limit. Keep this small on Vercel.
DATABASE_POOL_MAX="5"


# Google Gemini API key for AI-generated reply drafts and summaries.
# Create one at https://aistudio.google.com (Get API key). Free tier is enough for development.
GEMINI_API_KEY="your-gemini-api-key"
# Optional. Defaults to gemini-3.5-flash-lite (cheapest model with a free tier).
# GEMINI_MODEL="gemini-3.5-flash-lite"
