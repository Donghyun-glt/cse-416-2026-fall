# Application credentials: configured once by the MailFlow team on the server.
# Users of the hosted app only click "Log in with Google"; they need no .env file.
# For local development, copy this file to frontend/.env.local and fill it in.
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
# In production, register and use https://your-domain.com/api/google/callback.

# Optional. Defaults to frontend/data/mailflow.db when npm runs from frontend/.
MAILFLOW_DB_PATH="data/mailflow.db"

