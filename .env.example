# Application credentials: configured once by the MailFlow team on the server.
# Users of the hosted app only click "Log in with Google"; they need no .env file.
# For local development, copy this file to frontend/.env.local and fill it in.
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
# In production, register and use https://your-domain.com/api/google/callback.

# Managed PostgreSQL connection string. Keep SSL requirements in the URL,
# for example: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Generate a long random value and keep it server-side. Changing it invalidates
# stored OAuth sessions because Google tokens are encrypted with this secret.
SESSION_SECRET="replace-with-at-least-32-random-bytes"

# Optional per-instance connection-pool limit. Keep this small on Vercel.
DATABASE_POOL_MAX="5"


# Google Gemini API key for AI-generated reply drafts and summaries.
# Create one at https://aistudio.google.com (Get API key). Free tier is enough for development.
GEMINI_API_KEY="your-gemini-api-key"
# Optional. Defaults to gemini-3.5-flash-lite (cheapest model with a free tier).
# GEMINI_MODEL="gemini-3.5-flash-lite"
